[Unit]
Description=Jarvis Assistant Daemon
# Демон должен стартовать уже ПОСЛЕ старта графической сессии, иначе на
# слабом железе он конкурирует с GNOME Shell за CPU/RAM прямо в момент логина
# (это одна из причин «падения» сессии). PartOf= — при завершении сессии
# демон останавливается вместе с ней.
After=graphical-session.target sound.target
Wants=graphical-session.target
PartOf=graphical-session.target

# Защита от «петли» перезапусков (была в старой версии: 384 рестарта).
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=%h/.local/share/jarvis-assistant
ExecStart=%h/.local/share/jarvis-assistant/venv/bin/python -m jarvis.main daemon
Restart=on-failure
RestartSec=10

# Не мешаем рабочему столу: понижаем приоритет и отдаём меньше CPU/IO.
Nice=10
CPUWeight=20
IOWeight=20

# Ограничение памяти: фоновый режим лёгкий, а пик при распознавании —
# не должен выбивать систему на слабом железе.
MemoryHigh=900M
MemoryMax=1500M

Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=graphical-session.target
